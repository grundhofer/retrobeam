{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retrobeam",
  "main": "./src/index.ts",
  // The product's own domain. ONE canonical host on purpose: every capability
  // this app hands out lives in localStorage (session key, admin token), and
  // localStorage is per ORIGIN — a facilitator who created a board on the apex
  // and then opened it on www would arrive as a stranger without their own
  // admin rights. www is therefore a redirect at the edge, never a second
  // custom domain.
  "routes": [{ "pattern": "retrobeam.de", "custom_domain": true }],
  // Load-bearing: declaring ANY route switches the workers.dev subdomain off
  // by default, and the first deploy of the route above took production down
  // with it (the custom domain could not attach because the zone still held an
  // imported A record). Keeping workers.dev alive means a failed or pending
  // custom domain can never again leave the app with no reachable origin.
  "workers_dev": true,
  "compatibility_date": "2026-07-01",
  "assets": {
    // In dev/build the Vite plugin replaces this with the SPA client build;
    // ./public only backs `wrangler dev` without Vite and the test pool.
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom",
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  // KLIPY_API_KEY is deliberately NOT here. A binding name cannot be both a var
  // and a secret — declaring it empty made `wrangler secret put KLIPY_API_KEY`
  // fail with "Binding name already in use", so the documented way to switch
  // GIF search on did not work. It is a secret only; its type is declared in
  // src/env.d.ts, and absent means GIF search reports itself unavailable.
  "vars": {
    // Stored gif URLs must be https on this host (or a subdomain) — stops a
    // malicious client planting an arbitrary external <img> tracking beacon.
    // Verified 2026-09-05: KLIPY serves media from static.klipy.com, which this
    // suffix covers. Set it to your provider's media host if you swap provider.
    "GIF_HOST_SUFFIX": "klipy.com",
  },
  // Per-IP brakes. Board creation and duplication are unauthenticated and each
  // mints a permanent, alarm-armed Durable Object; the GIF proxy spends the
  // operator's provider quota. The free-tier allowance is account-wide, so an
  // unthrottled script takes every board offline until midnight UTC.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "GIF_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed is the only DO type available on the free plan.
      "new_sqlite_classes": ["BoardRoom"],
    },
    {
      "tag": "v2",
      // SQLite-backed because that is the only class type the free plan
      // offers; the limiter itself keeps no storage (see rate-limiter.ts).
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],
  "observability": {
    "enabled": true,
    // Invocation logs retain the full request URL, and every board URL IS the
    // participant capability (/api/boards/:id, /ws, /export) — plus GIF search
    // terms. Retaining them contradicts the "no tracking" promise in docs/05.
    // Explicit console.error output (the DO's detached-promise logging) is
    // unaffected and still reaches Workers Logs.
    "logs": {
      "invocation_logs": false,
    },
  },
  "env": {
    // PR previews deploy here (worker "retrobeam-preview") so preview builds
    // get their own DO namespace and can never touch production boards.
    "preview": {
      // EMPTY ON PURPOSE, and load-bearing. `routes` is inherited by named
      // environments, so without this the preview Worker claims the
      // PRODUCTION custom domain — and because previews deliberately get their
      // own Durable Object namespace, retrobeam.de would start answering from
      // an empty board store. Every real retro would look deleted.
      // A preview is reached through its own workers.dev/preview-alias URL.
      "routes": [],
      "durable_objects": {
        "bindings": [
          {
            "name": "BOARD_ROOM",
            "class_name": "BoardRoom",
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter",
          },
        ],
      },
      // wrangler does NOT inherit top-level vars or bindings into a named
      // environment — they have to be repeated or they are simply absent.
      "vars": {
        "GIF_HOST_SUFFIX": "klipy.com",
      },
      "ratelimits": [
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "GIF_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
