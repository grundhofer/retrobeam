{
  "name": "retrobeam",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian Grundhöfer",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --filter @retrobeam/web dev",
    "build": "pnpm --filter @retrobeam/web build",
    "check": "pnpm -r run check && tsc -p tsconfig.e2e.json && node scripts/check-tailwind-floor.mjs",
    "check:legal": "node scripts/check-legal-placeholders.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
