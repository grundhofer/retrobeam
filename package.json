{
  "name": "retrobeam",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian Grundhöfer",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --filter @retrobeam/web dev",
    "build": "pnpm --filter @retrobeam/web build",
    "check": "pnpm -r run check && tsc -p tsconfig.e2e.json && node scripts/check-tailwind-floor.mjs && node scripts/check-contrast.mjs && node scripts/check-tw-defaults.mjs && node scripts/check-copy.mjs && node --test \"scripts/*.test.mjs\"",
    "check:legal": "node scripts/check-legal-placeholders.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
